# Higgsfield API credentials from https://console.higgsfield.ai  (format: KEY_ID:KEY_SECRET)
HF_KEY=
# Optional override; defaults to https://api.higgsfield.ai
# HF_API_BASE_URL=

# Local dev without spending credits: returns a sample video after ~9s.
# HIGGSFIELD_MOCK=1

# Provisioned by `vercel integration add neon` / `vercel blob create-store`
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# Random string; Higgsfield webhooks must carry it. Webhooks are only registered on https origins.
WEBHOOK_SECRET=

# Public origin, used for share links and webhook URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Free renders per browser / per IP per rolling 24h when using the site key.
FREE_DAILY_LIMIT=3
IP_DAILY_LIMIT=12
